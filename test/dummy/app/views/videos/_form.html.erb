<%= form_with url: @form_url, method: @form_method, scope: :video do %>
  <%= hidden_field_tag :workspace_id, @workspace_id %>
  <%= render FlatPack::Stack::Component.new(gap: :md) do %>
    <%= recording_studio_video_fields(@video) %>
    <% if @video.content_type == "video" %>
      <%= recording_studio_video_player(@video) %>
    <% end %>
    <%= render FlatPack::ButtonGroup::Component.new(variant: :outlined, collapse: false) do |group| %>
      <% group.button(FlatPack::Button::Component.new(text: "Save", type: "submit", style: :default, size: :md)) %>
      <% group.button(FlatPack::Button::Component.new(text: "Cancel", href: videos_path, style: :ghost, size: :md)) %>
    <% end %>
  <% end %>
<% end %>
